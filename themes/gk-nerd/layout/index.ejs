<%# Homepage — redesigned per /Users/glebkalinin/Downloads/Gleb's-portfolio-redesign/
    Content lives in source/_data/redesign.yml (mirrors the export's renderVals()).
    Image slots use <picture> with AVIF → WebP for size.
    The 4D vault graph reuses the existing /js/vault-graph.js — it self-mounts on
    #vault-graph-container, which lives inside .hero-visual below. %>

<% const d = (site.data && site.data.redesign) || {}; %>

<!-- =================== NAV =================== -->
<nav class="home-nav">
  <a href="#top" class="wordmark">Gleb Kalinin</a>
  <div class="nav-links">
    <a href="#story">the story</a>
    <a href="#method">the method</a>
    <a href="#labs">labs</a>
    <a href="#community">community</a>
    <a href="https://t.me/glebkalinin">telegram ↗</a>
    <% if (theme.whatsapp) { %>
      <a href="<%= wa_me(theme.whatsapp) %>">whatsapp ↗</a>
    <% } %>
  </div>
</nav>

<!-- =================== HERO =================== -->
<header id="top" class="home-hero">
  <div class="hero-copy">
    <h1 class="st-hero">Somebody has to imagine the future. I&rsquo;d rather build it and live in it.</h1>
    <p>I use science fiction, speculative design and vibe-coding to imagine daily life with thinking machines &mdash; then I build working systems and live with them until the fiction stops being fiction.</p>
    <p>This page is the story of what happens when you take that seriously. Six chapters. Every one of them ships.</p>
    <div class="hero-actions">
      <a href="#story" class="cta-primary">Read the story ↓</a>
      <a href="#labs" class="cta-ghost">Join a lab</a>
    </div>
  </div>
  <div class="hero-visual" id="hero-visual">
    <div class="vault-graph-container" id="vault-graph-container"></div>
    <p class="hero-caption">the digital body &mdash; drag to rotate, scroll to zoom, click a node</p>
  </div>
</header>

<!-- =================== STORY =================== -->
<main id="story" class="story">
  <div class="section-intro">
    <h2 class="vf-bloom">The story so far</h2>
    <p>Every system I build starts the same way: as a scene from a life that doesn&rsquo;t quite exist yet. I write the scene down, then I refuse to let it stay fiction. What follows are six of those scenes &mdash; and the working software each one became.</p>
  </div>

  <% (d.chapters || []).forEach(function(ch, i) { %>
    <article class="ch-block">
      <div class="ch-text">
        <span class="ch-rule" aria-hidden="true"></span>
        <h3 class="vf-bloom"><%= ch.title %></h3>
        <p class="ch-fict"><%= ch.fiction1 %></p>
        <p class="ch-fict"><%= ch.fiction2 %></p>
        <p class="ch-real"><%= ch.realIntro %> <strong><%= ch.project %></strong> &mdash; <%= ch.real %></p>
      </div>
      <div class="ch-card">
        <div class="card-frame">
          <div class="card-image">
            <picture>
              <source srcset="<%= ch.img.replace(/\.png$/, '.avif') %>" type="image/avif">
              <source srcset="<%= ch.img.replace(/\.png$/, '.webp') %>" type="image/webp">
              <%# First chapter is above the fold on most viewports — eager + high
                  priority cuts LCP by 100-300ms on slow connections. %>
              <img src="<%= ch.img.replace(/\.png$/, '.webp') %>" alt="<%= ch.project %> — <%= ch.tagline %>" width="800" height="260"<% if (i === 0) { %> loading="eager" fetchpriority="high"<% } else { %> loading="lazy"<% } %> decoding="async">
            </picture>
          </div>
          <div class="card-body">
            <p class="project"><%= ch.project %></p>
            <p class="tagline"><%= ch.tagline %></p>
            <a class="ch-link" href="<%= ch.link %>" target="_blank" rel="noopener"><%= ch.linkLabel %> →</a>
          </div>
        </div>
      </div>
    </article>
    <% if (i < d.chapters.length - 1) { %>
      <div class="ch-divider"><span>···</span></div>
    <% } %>
  <% }); %>
</main>

<!-- =================== WORKBENCH =================== -->
<section id="workbench" class="workbench-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">Meanwhile, on the workbench</h2>
      <p>Not everything gets a chapter. Some things exist because the tools were lying around and the itch wouldn&rsquo;t go away &mdash; instruments, workstations, benchmarks. All real, all in use.</p>
    </div>
    <div class="grid-3">
      <% (d.workbench || []).forEach(function(wb) { %>
        <div class="fx-card workbench-card">
          <p class="kind"><%= wb.kind %></p>
          <h3><%= wb.name %></h3>
          <p class="desc"><%= wb.desc %></p>
          <p class="meta"><%= wb.meta %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- =================== METHOD =================== -->
<section id="method" class="method">
  <div class="home-container">
    <h2 class="vf-bloom">I imagine how daily life will feel when the tech catches up. Then I build it and live with it now.</h2>
    <p class="lede">Working prototypes, not concept renders. Childhood sci-fi never left &mdash; it just changed medium. Every chapter above followed the same three moves.</p>
    <div class="grid-3">
      <div class="fx-step">
        <h3>Prototype the future</h3>
        <p>If you can&rsquo;t use it daily, it&rsquo;s not real yet. The fiction earns its keep the day it compiles.</p>
      </div>
      <div class="fx-step">
        <h3>Live with it</h3>
        <p>The real question isn&rsquo;t &ldquo;what can this AI do?&rdquo; but &ldquo;what happens when a person and an AI live together for months?&rdquo;</p>
      </div>
      <div class="fx-step">
        <h3>Digital body, not second brain</h3>
        <p>Memory + tools + agency + senses. An organism, not a tool. The projects above are its organs.</p>
      </div>
    </div>
  </div>
</section>

<!-- =================== TIMELINE =================== -->
<% if (d.showTimeline) { %>
<section class="timeline">
  <h2 class="vf-bloom">Things I shipped and slept next to</h2>
  <p class="lede">The story didn&rsquo;t start with agents. It started twenty-five years ago, with the habit of building whatever I couldn&rsquo;t stop thinking about.</p>
  <div>
    <% (d.timeline || []).forEach(function(t) { %>
      <div class="fx-row">
        <p class="when"><%= t.when %></p>
        <p class="what-note"><strong><%= t.what %></strong> &mdash; <%= t.note %></p>
      </div>
    <% }); %>
  </div>
</section>
<% } %>

<!-- =================== LABS =================== -->
<section id="labs" class="labs-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">Where the story becomes teachable</h2>
      <p>The hard part of working with AI isn&rsquo;t technical &mdash; it&rsquo;s unlearning what you think is impossible. Week one: &ldquo;I can&rsquo;t code.&rdquo; Week four: shipping working products. Over 350 people have gone through my labs, and most of them aren&rsquo;t developers.</p>
    </div>
    <div class="grid-3">
      <% (d.labs || []).forEach(function(lab) { %>
        <div class="fx-card lab-card">
          <h3><%= lab.name %></h3>
          <p class="desc"><%= lab.desc %></p>
          <p class="meta"><%= lab.meta %></p>
          <a class="lab-link" href="<%= lab.link %>" target="_blank" rel="noopener">Join the lab →</a>
        </div>
      <% }); %>
    </div>
    <blockquote class="quote">
      <p>&ldquo;There&rsquo;s simply no boundary anymore of what you can&rsquo;t do.&rdquo;</p>
      <cite>&mdash; Mikhail, lab participant</cite>
    </blockquote>
  </div>
</section>

<!-- =================== COMMUNITY =================== -->
<section id="community" class="community">
  <div class="home-container">
    <h2 class="vf-bloom">Nobody imagines the future alone</h2>
    <p class="lede">The labs produced something I didn&rsquo;t plan for: rooms full of people who kept building after the sessions ended. These are the rooms.</p>
    <div class="grid-2">
      <% (d.communities || []).forEach(function(c) { %>
        <a class="community-card" href="<%= c.link %>" target="_blank" rel="noopener">
          <span class="c-name"><%= c.name %></span>
          <span class="c-desc"><%= c.desc %></span>
          <span class="c-size"><%= c.size %></span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- =================== HUMANE AGENTIC DESIGN =================== -->
<%# Skill pack + plugin set that powers the design method behind this site.
    Source: https://humane.salient.community/ — six core skills + install commands. %>
<section id="humane" class="labs-section humane-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">Put a design method next to your agent.</h2>
      <p>Humane Agentic Design turns a real product question into evidence, a prototype, a tested interface, a next learning step &mdash; and, when the work is ready, a final product. The interface is the last thing the agent sees. Seventeen skills that teach your agent to design like a person who has shipped things.</p>
    </div>
    <div class="grid-3">
      <article class="fx-card">
        <p class="kind">01 · setup</p>
        <h3>Setup</h3>
        <p class="desc">Install the skill pack, point it at a real product question, and the rest of the workflow can begin. The first move is always the boring one.</p>
        <p class="meta">foundation · installs in 30 seconds</p>
      </article>
      <article class="fx-card">
        <p class="kind">02 · frame</p>
        <h3>Jobs to be done</h3>
        <p class="desc">Ground the work in the job a real person is trying to get done. Without this, the agent ships features that satisfy nobody &mdash; including itself.</p>
        <p class="meta">evidence before artifacts</p>
      </article>
      <article class="fx-card">
        <p class="kind">03 · prototype</p>
        <h3>Prototype</h3>
        <p class="desc">Make the future real enough to use. The fiction earns its keep the day it compiles &mdash; and only a working prototype tells you which fiction survives contact.</p>
        <p class="meta">fiction → function</p>
      </article>
      <article class="fx-card">
        <p class="kind">04 · walkthrough</p>
        <h3>Walkthrough</h3>
        <p class="desc">Drive a real person through the thing you just built. Watch where they hesitate, where they reach for controls that aren&rsquo;t there, where the system goes quiet.</p>
        <p class="meta">observation over opinion</p>
      </article>
      <article class="fx-card">
        <p class="kind">05 · tokens</p>
        <h3>Design tokens</h3>
        <p class="desc">A shared vocabulary of color, type, spacing, and radius that every other skill can read. Tokens are how a team agrees on what feels right.</p>
        <p class="meta">the grammar of taste</p>
      </article>
      <article class="fx-card">
        <p class="kind">06 · review</p>
        <h3>Review</h3>
        <p class="desc">One consolidated verdict across structure, copy, usability, and contrast &mdash; not five reports you have to reconcile. Evidence locators, not vibes.</p>
        <p class="meta">ranked by user impact</p>
      </article>
    </div>

    <div class="humane-install">
      <h3 class="vf-bloom">Install the pack</h3>
      <p>Two commands. Works in Claude Code and Cursor. The agent gains seventeen skills; you gain a design method.</p>
      <div class="install-cmds">
        <code class="install-cmd"><span class="install-label">npx</span> skills add glebis/humane-agentic-design</code>
        <code class="install-cmd"><span class="install-label">/plugin</span> marketplace add glebis/humane-agentic-design</code>
      </div>
      <a class="cta-ghost humane-cta" href="https://humane.salient.community/" target="_blank" rel="noopener">Read the full skill pack ↗</a>
    </div>
  </div>
</section>

