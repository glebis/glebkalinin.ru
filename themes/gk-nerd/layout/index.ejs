<%# Homepage — AI-first product builder. Products come from source/_data/products.yml;
    "how I build" is one real day The story is a single real day (source/_data/day.yml),
    rendered by the React + ui-sdk island in /homepage-app (built to /home-app/).
    Everything inside #day-app below is the no-JS / SEO fallback; the island
    replaces it on load. Projects come from source/_data/redesign.yml. %>

<% const d = (site.data && site.data.redesign) || {}; %>
<% const day = (site.data && site.data.day) || { beats: [] }; %>
<% const beats = (day.beats || []).filter(function (b) { return !b.draft; }); %>

<!-- =================== NAV =================== -->
<nav class="home-nav" aria-label="Main">
  <a href="#top" class="wordmark">Gleb Kalinin</a>
  <div class="nav-links">
    <a href="#products">products</a>
    <a href="#day">how I build</a>
    <% if (((site.data.media||{}).photos||[]).length || ((site.data.media||{}).videos||[]).length) { %><a href="#work">photo + video</a><% } %>
    <a href="#labs">labs</a>
    <a href="/mentoring/">mentoring</a>
  </div>
  <div class="nav-actions">
    <a href="#contact" class="nav-cta">Work with me</a>
    <%- partial('_partial/theme-toggle') %>
  </div>
</nav>

<!-- =================== HERO =================== -->
<header id="top" class="home-hero">
  <div class="hero-copy">
    <h1 class="st-hero">I build AI-first products, and use them every day.</h1>
    <p>Products where agents do real work and people stay in charge: the agent shows its evidence, asks before it acts, and leaves the decision with you. I design them, build them, and run my own day on them.</p>
    <p>Clients bring me an AI product to get from idea to working software. In my labs I teach the same method to teams.</p>
    <div class="hero-actions">
      <a href="#contact" class="cta-primary">Work with me</a>
      <a href="#products" class="cta-ghost">See what I&rsquo;ve shipped ↓</a>
    </div>
  </div>
  <div class="hero-visual" id="graph">
    <div class="vault-graph-container" id="vault-graph-container"></div>
    <p class="hero-caption">the vault this day wrote into &mdash; drag to rotate, click a node</p>
  </div>
</header>

<!-- =================== PRODUCTS =================== -->
<% const products = ((site.data && site.data.products) || {}).products || []; %>
<% const productNames = products.map(function (p) { return p.name.toLowerCase(); }); %>
<% if (products.length) { %>
<section id="products" class="workbench-section products-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">What I&rsquo;ve shipped</h2>
      <p>Each one started as a real problem, mine or a client&rsquo;s. With each, I note the product decision that mattered most, because that&rsquo;s the part an agent can&rsquo;t make for you.</p>
    </div>
    <div class="grid-2 product-grid">
      <% products.forEach(function (p) { %>
        <article class="fx-card product-card">
          <p class="kind"><%= p.kind %></p>
          <h3><% if (p.link) { %><a href="<%= p.link %>"<% if (!p.link.startsWith('#')) { %> target="_blank" rel="noopener"<% } %>><%= p.name %></a><% } else { %><%= p.name %><% } %></h3>
          <p class="desc"><%= p.what %></p>
          <p class="decision"><strong>Decision:</strong> <%= p.decision %></p>
          <p class="meta"><%= p.proof %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- =================== THE DAY =================== -->
<main id="day" class="day-section">
  <div class="section-intro">
    <h2 class="vf-bloom">How I build: one real day</h2>
    <p>The products above come out of a working day like this one: <strong><%= day.weekday %>, 15&nbsp;November&nbsp;2026</strong>, <%= day.place %>, taken from the logs with private details left out. <%= beats.length %> moments in 24 hours. Blue marks an agent working on its own; the rest is me, or the two of us together. Drag the clock, press play, or ask the agent on the right.</p>
  </div>

  <div id="day-app" data-fallback>
    <ol class="day-fallback">
      <% beats.forEach(function (b) { %>
        <li>
          <time datetime="<%= day.date %>T<%= b.at %>"><%= b.at %></time>
          <strong><%= b.title %></strong>
          <p><%= b.body %></p>
        </li>
      <% }); %>
    </ol>
  </div>
  <script type="application/json" id="day-data"><%- JSON.stringify(day).replace(/</g, '\\u003c') %></script>
</main>

<!-- =================== WHAT RAN IT =================== -->
<section id="organs" class="workbench-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">What else ran that day</h2>
      <p>Smaller tools and experiments from the same workbench. Each started as a scene I wanted to live in and became software I use every day. Most of it is open.</p>
    </div>
    <div class="grid-3">
      <% (d.chapters || []).filter(function (ch) { return productNames.indexOf(String(ch.project).toLowerCase()) === -1; }).forEach(function (ch) { %>
        <a class="fx-card workbench-card organ-card" href="<%= ch.link %>" target="_blank" rel="noopener">
          <p class="kind"><%= ch.project %></p>
          <h3><%= ch.tagline %></h3>
          <p class="desc"><%= ch.real %></p>
          <p class="meta"><%= ch.linkLabel %> ↗</p>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- =================== AWAY FROM THE TERMINAL (photography + video) ===================
     Content: source/_data/media.yml. Each half renders only when it has items. -->
<% const media = (site.data && site.data.media) || {}; %>
<% const photos = media.photos || [], videos = media.videos || []; %>
<% if (photos.length || videos.length) { %>
<section id="work" class="labs-section media-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">Away from the terminal</h2>
      <p><%= photos.length ? media.intro_photos : media.intro_videos %></p>
    </div>

    <% if (photos.length) { %>
      <h3 class="media-sub">Photography</h3>
      <div class="media-grid sdk-grid">
        <% photos.forEach(function (p, i) { %>
          <figure class="media-item" style="--ratio: <%= p.ratio || '4 / 5' %>">
            <picture>
              <% if (p.webp) { %><source srcset="<%= p.src.replace(/\.(jpe?g|png)$/i, '.webp') %>" type="image/webp"><% } %>
              <img src="<%= p.src %>" alt="<%= p.alt || '' %>" loading="lazy" decoding="async">
            </picture>
            <% if (p.caption) { %><figcaption><span><%= p.caption %></span></figcaption><% } %>
          </figure>
        <% }); %>
      </div>
    <% } %>

    <% if (videos.length) { %>
      <h3 class="media-sub">Video</h3>
      <% if (photos.length) { %><p class="media-lede"><%= media.intro_videos %></p><% } %>
      <div class="media-grid media-videos sdk-grid">
        <% videos.forEach(function (v) { %>
          <figure class="media-item">
            <video class="media-loop" src="<%= v.src %>" poster="<%= v.poster || '' %>" muted loop playsinline preload="none" aria-label="<%= v.title %>"></video>
            <figcaption>
              <span><%= v.title %><% if (v.caption) { %> · <%= v.caption %><% } %></span>
              <% if (v.full) { %><a href="<%= v.full %>" target="_blank" rel="noopener">Watch full ↗</a><% } %>
            </figcaption>
          </figure>
        <% }); %>
      </div>
      <%# Play loops only while on screen, never for reduced motion (then show controls). %>
      <script>
        (function () {
          var loops = document.querySelectorAll('.media-loop');
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
            loops.forEach(function (v) { v.controls = true; v.preload = 'metadata'; });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { e.isIntersecting ? e.target.play().catch(function () {}) : e.target.pause(); });
          }, { threshold: 0.35 });
          loops.forEach(function (v) { io.observe(v); });
        })();
      </script>
    <% } %>
  </div>
</section>
<% } %>

<!-- =================== HUMANE AGENTIC DESIGN =================== -->
<%# Skill pack + plugin set that powers the design method behind this site.
    Source: https://humane.salient.community/ — six core skills + install commands. %>
<section id="humane" class="labs-section humane-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">Put a design method next to your agent.</h2>
      <p>Humane Agentic Design turns a real product question into evidence, a prototype, a tested interface, a next learning step &mdash; and, when the work is ready, a final product. The interface is the last thing the agent sees. Seventeen skills that teach your agent to design like a person who has shipped things.</p>
    </div>
    <div class="grid-3">
      <article class="fx-card">
        <p class="kind">Step 1</p>
        <h3>Setup</h3>
        <p class="desc">Install the skill pack, point it at a real product question, and the rest of the workflow can begin. The first move is always the boring one.</p>
        <p class="meta">foundation · installs in 30 seconds</p>
      </article>
      <article class="fx-card">
        <p class="kind">Step 2</p>
        <h3>Jobs to be done</h3>
        <p class="desc">Ground the work in the job a real person is trying to get done. Without this, the agent ships features that satisfy nobody &mdash; including itself.</p>
        <p class="meta">evidence before artifacts</p>
      </article>
      <article class="fx-card">
        <p class="kind">Step 3</p>
        <h3>Prototype</h3>
        <p class="desc">Make the future real enough to use. The fiction earns its keep the day it compiles &mdash; and only a working prototype tells you which fiction survives contact.</p>
        <p class="meta">fiction → function</p>
      </article>
      <article class="fx-card">
        <p class="kind">Step 4</p>
        <h3>Walkthrough</h3>
        <p class="desc">Drive a real person through the thing you just built. Watch where they hesitate, where they reach for controls that aren&rsquo;t there, where the system goes quiet.</p>
        <p class="meta">observation over opinion</p>
      </article>
      <article class="fx-card">
        <p class="kind">Step 5</p>
        <h3>Design tokens</h3>
        <p class="desc">A shared vocabulary of color, type, spacing, and radius that every other skill can read. Tokens are how a team agrees on what feels right.</p>
        <p class="meta">the grammar of taste</p>
      </article>
      <article class="fx-card">
        <p class="kind">Step 6</p>
        <h3>Review</h3>
        <p class="desc">One consolidated verdict across structure, copy, usability, and contrast &mdash; not five reports you have to reconcile. Evidence locators, not vibes.</p>
        <p class="meta">ranked by user impact</p>
      </article>
    </div>

    <div class="humane-install">
      <h3 class="vf-bloom">Install the pack</h3>
      <p>Two commands. Works in Claude Code and Cursor. The agent gains seventeen skills; you gain a design method.</p>
      <div class="install-cmds">
        <code class="install-cmd"><span class="install-label">npx</span> skills add glebis/humane-agentic-design</code>
        <code class="install-cmd"><span class="install-label">/plugin</span> marketplace add glebis/humane-agentic-design</code>
      </div>
      <a class="cta-ghost humane-cta" href="https://humane.salient.community/" target="_blank" rel="noopener">Read the full skill pack ↗</a>
    </div>
  </div>
</section>

<!-- =================== LABS =================== -->
<section id="labs" class="labs-section">
  <div class="home-container">
    <div class="section-intro">
      <h2 class="vf-bloom">Want a day like this?</h2>
      <p>The hard part of working with AI isn&rsquo;t technical &mdash; it&rsquo;s unlearning what you think is impossible. Week one: &ldquo;I can&rsquo;t code.&rdquo; Week four: shipping working products. Over 350 people have gone through my labs, and most of them aren&rsquo;t developers.</p>
    </div>
    <div class="grid-3">
      <% (d.labs || []).forEach(function(lab) { %>
        <div class="fx-card lab-card">
          <h3><%= lab.name %></h3>
          <p class="desc"><%= lab.desc %></p>
          <p class="meta"><%= lab.meta %></p>
          <a class="lab-link" href="<%= lab.link %>" target="_blank" rel="noopener">Join the lab →</a>
        </div>
      <% }); %>
    </div>
    <blockquote class="quote">
      <p>&ldquo;There&rsquo;s simply no boundary anymore of what you can&rsquo;t do.&rdquo;</p>
      <cite>&mdash; Mikhail, lab participant</cite>
    </blockquote>
  </div>
</section>

<!-- =================== COMMUNITY =================== -->
<section id="community" class="community">
  <div class="home-container">
    <h2 class="vf-bloom">Nobody imagines the future alone</h2>
    <p class="lede">The labs produced something I didn&rsquo;t plan for: rooms full of people who kept building after the sessions ended. These are the rooms.</p>
    <div class="grid-2">
      <% (d.communities || []).forEach(function(c) { %>
        <a class="community-card" href="<%= c.link %>" target="_blank" rel="noopener">
          <span class="c-name"><%= c.name %></span>
          <span class="c-desc"><%= c.desc %></span>
          <span class="c-size"><%= c.size %></span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

