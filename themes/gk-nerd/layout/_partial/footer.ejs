<footer class="site-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-left">
        <p>&copy; <%= new Date().getFullYear() %> <%= theme.author %>. <%= theme.location %></p>
        <p class="easter-egg-hint" title="↑↑↓↓←→←→BA">···</p>
      </div>
      <div class="footer-links">
        <a href="https://t.me/<%= theme.telegram %>" target="_blank">Telegram</a>
        <% if (theme.whatsapp) { %>
          <a href="<%= wa_me(theme.whatsapp) %>" target="_blank">WhatsApp</a>
        <% } %>
        <a href="https://github.com/glebis" target="_blank">GitHub</a>
        <a href="https://twitter.com/glebis" target="_blank">Twitter</a>
        <a href="/impressum/">Impressum</a>
      </div>
    </div>
  </div>
</footer>

<!-- Russian Blog (Hidden, revealed by Konami code) -->
<div id="ru-blog-portal" class="ru-portal" style="display: none;">
  <a href="/ru/">🇷🇺 Русский блог</a>
</div>